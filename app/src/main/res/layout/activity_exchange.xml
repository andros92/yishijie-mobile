<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/background">

    <!-- 顶栏 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="12dp"
        android:paddingBottom="12dp">

        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@drawable/ic_back"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="返回" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="交易所"
            android:textSize="20sp"
            android:textColor="@color/text_primary"
            android:textStyle="bold"
            android:layout_marginStart="12dp" />

        <Button
            android:id="@+id/btnHistory"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:text="成交记录"
            android:textSize="12sp"
            android:backgroundTint="@color/surface_light"
            android:textColor="@color/text_primary" />
    </LinearLayout>

    <!-- 在售列表 -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">
        <LinearLayout
            android:id="@+id/llListings"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingBottom="8dp" />
    </ScrollView>

    <TextView
        android:id="@+id/tvStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text=""
        android:textSize="13sp"
        android:textColor="@color/text_secondary"
        android:gravity="center"
        android:paddingTop="4dp"
        android:paddingBottom="4dp" />

    <!-- 挂单区 -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardBackgroundColor="@color/background_card"
        app:cardCornerRadius="16dp"
        app:cardElevation="1dp"
        app:strokeColor="@color/surface_border"
        app:strokeWidth="1dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="挂单出售"
                android:textSize="15sp"
                android:textColor="@color/text_primary"
                android:textStyle="bold"
                android:layout_marginBottom="4dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="平台收取 10% 手续费（由卖家承担）"
                android:textSize="12sp"
                android:textColor="@color/text_secondary"
                android:layout_marginBottom="10dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">
                <EditText
                    android:id="@+id/etItemKey"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_weight="1"
                    android:hint="物品key"
                    android:textSize="13sp"
                    android:background="@drawable/bg_input"
                    android:paddingHorizontal="10dp"
                    android:layout_marginEnd="6dp" />
                <EditText
                    android:id="@+id/etItemName"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_weight="1"
                    android:hint="名称"
                    android:textSize="13sp"
                    android:background="@drawable/bg_input"
                    android:paddingHorizontal="10dp"
                    android:layout_marginEnd="6dp" />
                <EditText
                    android:id="@+id/etItemQty"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_weight="1"
                    android:hint="数量"
                    android:inputType="number"
                    android:textSize="13sp"
                    android:background="@drawable/bg_input"
                    android:paddingHorizontal="10dp"
                    android:layout_marginEnd="6dp" />
                <EditText
                    android:id="@+id/etItemPrice"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_weight="1"
                    android:hint="价格"
                    android:inputType="number"
                    android:textSize="13sp"
                    android:background="@drawable/bg_input"
                    android:paddingHorizontal="10dp" />
            </LinearLayout>

            <EditText
                android:id="@+id/etItemQuality"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:hint="品质（装备填，如 epic；普通物品留空）"
                android:textSize="13sp"
                android:background="@drawable/bg_input"
                android:paddingHorizontal="10dp"
                android:layout_marginTop="8dp" />

            <Button
                android:id="@+id/btnList"
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:text="确认挂单"
                android:textSize="14sp"
                android:backgroundTint="@color/primary"
                android:layout_marginTop="10dp" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>
</LinearLayout>
