<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/background"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <Button
            android:id="@+id/btnBack"
            android:layout_width="64dp"
            android:layout_height="40dp"
            android:text="返回"
            android:textSize="14sp"
            android:backgroundTint="@color/accent" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="交易所"
            android:textSize="20sp"
            android:textColor="@color/text_primary"
            android:textStyle="bold"
            android:gravity="center" />
    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="在售列表（平台收 10% 手续费）："
        android:textSize="13sp"
        android:textColor="@color/text_secondary"
        android:paddingVertical="8dp" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">
        <LinearLayout
            android:id="@+id/llListings"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />
    </ScrollView>

    <TextView
        android:id="@+id/tvStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text=""
        android:textSize="13sp"
        android:textColor="@color/warning"
        android:paddingTop="8dp"
        android:gravity="center" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="挂单（装备请填品质；物品按数量）："
        android:textSize="13sp"
        android:textColor="@color/text_secondary"
        android:paddingTop="8dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">
        <EditText
            android:id="@+id/etItemKey"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:hint="物品key"
            android:textSize="13sp"
            android:background="@drawable/bg_input"
            android:paddingHorizontal="8dp"
            android:layout_marginEnd="6dp" />
        <EditText
            android:id="@+id/etItemName"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:hint="名称"
            android:textSize="13sp"
            android:background="@drawable/bg_input"
            android:paddingHorizontal="8dp"
            android:layout_marginEnd="6dp" />
        <EditText
            android:id="@+id/etItemQty"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:hint="数量"
            android:inputType="number"
            android:textSize="13sp"
            android:background="@drawable/bg_input"
            android:paddingHorizontal="8dp"
            android:layout_marginEnd="6dp" />
        <EditText
            android:id="@+id/etItemPrice"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:hint="价格"
            android:inputType="number"
            android:textSize="13sp"
            android:background="@drawable/bg_input"
            android:paddingHorizontal="8dp" />
    </LinearLayout>

    <EditText
        android:id="@+id/etItemQuality"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:hint="品质（装备：common/fine/rare/epic/legend，普通物品留空）"
        android:textSize="13sp"
        android:background="@drawable/bg_input"
        android:paddingHorizontal="8dp"
        android:layout_marginTop="8dp" />

    <Button
        android:id="@+id/btnList"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:text="挂单"
        android:textSize="15sp"
        android:backgroundTint="@color/primary"
        android:layout_marginTop="8dp" />

    <Button
        android:id="@+id/btnHistory"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:text="查看我的成交记录"
        android:textSize="14sp"
        android:backgroundTint="@color/accent"
        android:layout_marginTop="8dp" />
</LinearLayout>
