<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.yishijie.chuanshuo">

    <!-- 蓝牙权限 -->
    <uses-permission android:name="android.permission.BLUETOOTH" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADMIN" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />

    <!-- 网络权限 -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- 前台服务权限 -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Yishijie"
        android:usesCleartextTraffic="true">

        <!-- 主页面 -->
        <activity
            android:name=".ui.MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 存档管理页面 -->
        <activity
            android:name=".ui.SaveManagerActivity"
            android:exported="false" />

        <!-- 交易所浏览页（只读，交易仅手环可操作） -->
        <activity
            android:name=".ui.ExchangeBrowseActivity"
            android:exported="false" />

        <!-- PVP 竞技场（纯手机端） -->
        <activity
            android:name=".ui.PvpActivity"
            android:exported="false" />
        <activity
            android:name=".ui.PvpBattleActivity"
            android:exported="false" />

        <!-- 礼包码兑换 -->
        <activity
            android:name=".ui.RedeemActivity"
            android:exported="false" />

        <!-- 桥接中心页面 -->
        <activity
            android:name=".ui.BridgeActivity"
            android:exported="false" />

        <!-- 公告列表页面 -->
        <activity
            android:name=".ui.AnnouncementActivity"
            android:exported="false" />

        <!-- 手环连接服务 -->
        <service
            android:name=".service.CompanionService"
            android:exported="false"
            android:foregroundServiceType="connectedDevice" />

    </application>

</manifest>
